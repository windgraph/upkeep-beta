{
  "schema": "upkeep-policy/1",
  "note": "Your settings. Patterns use fnmatch: a trailing * matches any suffix. mode = report (list only) or auto (install by itself). schedule and selection are written by 'upkeep schedule' and 'upkeep select'. held = never upgraded here, reported as waiting for you. admin = packages that need an administrator shell: never attempted, reported with the command. in_use = id -> process names; a running process puts the upgrade off to the next run. check_after = id -> a check run after that package was upgraded. quiet = app names silenced in the stale check.",
  "mode": "report",
  "schedule": null,
  "selection": {"mode": "all", "excluded": [], "only": []},
  "upgrade_timeout_s": 900,
  "fail_limit": 2,
  "held": [
    "Microsoft.VisualStudioCode",
    "Anthropic.Claude",
    "Python.Python.*"
  ],
  "held_override": [],
  "admin": [],
  "quiet": [],
  "check_after": {
    "OpenJS.NodeJS": "node_version",
    "OpenJS.NodeJS.LTS": "node_version",
    "Git.Git": "git_version"
  },
  "in_use": {
    "Microsoft.WindowsTerminal": ["WindowsTerminal.exe"],
    "Microsoft.PowerShell": ["pwsh.exe"],
    "OpenJS.NodeJS": ["node.exe"],
    "OpenJS.NodeJS.LTS": ["node.exe"],
    "Microsoft.Teams": ["ms-teams.exe", "Teams.exe"],
    "TheDocumentFoundation.LibreOffice": ["soffice.bin", "soffice.exe"],
    "GitHub.GitHubDesktop": ["GitHubDesktop.exe"],
    "Anysphere.Cursor": ["Cursor.exe"],
    "VSCodium.VSCodium": ["VSCodium.exe"],
    "JetBrains.*": ["idea64.exe", "pycharm64.exe", "webstorm64.exe", "rider64.exe", "clion64.exe", "goland64.exe", "phpstorm64.exe", "datagrip64.exe"],
    "Docker.DockerDesktop": ["Docker Desktop.exe", "com.docker.backend.exe"],
    "Postman.Postman": ["Postman.exe"],
    "Discord.Discord": ["Discord.exe"],
    "SlackTechnologies.Slack": ["slack.exe"],
    "Zoom.Zoom": ["Zoom.exe"],
    "Telegram.TelegramDesktop": ["Telegram.exe"],
    "Spotify.Spotify": ["Spotify.exe"],
    "Valve.Steam": ["steam.exe"],
    "OBSProject.OBSStudio": ["obs64.exe"],
    "VideoLAN.VLC": ["vlc.exe"],
    "Notepad++.Notepad++": ["notepad++.exe"],
    "Obsidian.Obsidian": ["Obsidian.exe"],
    "Notion.Notion": ["Notion.exe"],
    "Figma.Figma": ["Figma.exe"],
    "Bitwarden.Bitwarden": ["Bitwarden.exe"],
    "KeePassXCTeam.KeePassXC": ["KeePassXC.exe"],
    "Microsoft.PowerToys": ["PowerToys.exe"],
    "7zip.7zip": ["7zFM.exe", "7zG.exe"],
    "WinSCP.WinSCP": ["WinSCP.exe"],
    "PuTTY.PuTTY": ["putty.exe"],
    "Audacity.Audacity": ["Audacity.exe"],
    "calibre.calibre": ["calibre.exe"],
    "Zotero.Zotero": ["zotero.exe"],
    "qBittorrent.qBittorrent": ["qbittorrent.exe"]
  }
}
